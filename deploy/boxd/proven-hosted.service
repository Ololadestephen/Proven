[Unit]
Description=Proven hosted agents (testnet)
After=proven-relay.service
Wants=proven-relay.service

[Service]
User=boxd
WorkingDirectory=/home/boxd/proven/agent
ExecStart=/usr/local/bin/node --env-file=/home/boxd/proven/.hosted.env src/hosted/service.ts
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/boxd/proven/runs
ProtectKernelTunables=true
ProtectControlGroups=true
MemoryMax=1500M
TasksMax=128
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
