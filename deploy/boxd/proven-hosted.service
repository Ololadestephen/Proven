[Unit]
Description=Proven hosted agents (testnet)
After=proven-relay.service
Wants=proven-relay.service

[Service]
User=proven-hosted
Group=proven-hosted
SupplementaryGroups=proven-sock
WorkingDirectory=/opt/proven/agent
Environment=PROVEN_RELAY_SOCKET=/run/proven/relay.sock
Environment=PROVEN_RELAY_SOCKET_SHARED=yes
Environment=PROVEN_HOSTED_DATA=/var/lib/proven/hosted
ExecStart=/opt/node/node --env-file=/etc/proven/hosted.env src/hosted/service.ts
Restart=on-failure
RestartSec=10
UMask=0077
ReadWritePaths=/var/lib/proven/hosted
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
# Docker's socket would be root, and the machine's own boxd tool could reach other machines.
InaccessiblePaths=-/var/run/docker.sock -/run/docker.sock -/usr/local/bin/boxd -/usr/local/bin/claude -/usr/local/bin/codex -/usr/local/bin/gh -/run/boxd
MemoryMax=1500M
TasksMax=128
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
