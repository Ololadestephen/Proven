[Unit]
Description=Proven web server (mainnet, unaudited, owner-funded, closed; localhost only)
After=proven-relay-mainnet.service
Wants=proven-relay-mainnet.service

[Service]
User=proven-web
Group=proven-web
SupplementaryGroups=proven-sock
WorkingDirectory=/opt/proven/web
Environment=PROVEN_PORT=4176
Environment=PROVEN_RELAY_SOCKET=/run/proven-mainnet/relay.sock
EnvironmentFile=/etc/proven/web-mainnet.env
# No --public: it answers on this machine only, until the owner says yes.
ExecStart=/opt/node/node src/server.ts
Restart=on-failure
RestartSec=5
UMask=0077
ReadWritePaths=/opt/proven/runs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
# Docker's socket would be root, and the machine's own boxd tool could reach other machines.
InaccessiblePaths=-/var/run/docker.sock -/run/docker.sock -/usr/local/bin/boxd -/usr/local/bin/claude -/usr/local/bin/codex -/usr/local/bin/gh -/run/boxd
MemoryMax=1500M
TasksMax=128
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
