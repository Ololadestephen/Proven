[Unit]
Description=Proven relay (testnet)
After=network-online.target
Wants=network-online.target

[Service]
User=boxd
WorkingDirectory=/home/boxd/proven/relay
# Set here, so a mistyped env file cannot leave a reachable relay without signature checks.
Environment=PROVEN_RELAY_REQUIRE_SIGNATURES=yes
# Only one relay runs on this machine, so a socket left by a crash or restart is always stale.
ExecStartPre=-/bin/rm -f /home/boxd/proven/runs/private/relay.sock
ExecStart=/usr/local/bin/node --env-file=/home/boxd/proven/.relay.env src/handoff.ts
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/boxd/proven/runs
ProtectKernelTunables=true
ProtectControlGroups=true
MemoryMax=1500M
TasksMax=128
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
