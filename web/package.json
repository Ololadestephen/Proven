{
  "name": "proven-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "demo:arm": "node src/demo-arm.ts",
    "test": "node --test src/*.test.ts src/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src ui scripts test-fixtures public",
    "format:check": "prettier --check src ui scripts test-fixtures public",
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
