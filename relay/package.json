{
  "name": "proven-relay",
  "version": "0.1.0",
  "description": "Pins private inputs, triggers escrow calls to OutLayer, and audits recorded attestations",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "relay": "node --env-file=../.env src/cli.ts",
    "handoff": "node --env-file=../.env src/handoff.ts",
    "publish-verifier": "node --env-file=../.env src/publish.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "near-api-js": "7.3.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3"
  }
}
